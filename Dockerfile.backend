FROM webdevops/php-nginx:8.1-alpine

ARG CACHEBUST=1

ENV WEB_DOCUMENT_ROOT=/app

RUN mkdir -p /app/core /app/routes

COPY backend/api/index.php        /app/index.php
COPY backend/api/init_db.php      /app/init_db.php
COPY backend/api/.htaccess        /app/.htaccess
COPY backend/api/core/db.php      /app/core/db.php
COPY backend/api/core/helpers.php /app/core/helpers.php
COPY backend/api/routes/auth.php        /app/routes/auth.php
COPY backend/api/routes/obras.php       /app/routes/obras.php
COPY backend/api/routes/metas.php       /app/routes/metas.php
COPY backend/api/routes/historico.php   /app/routes/historico.php
COPY backend/api/routes/restricoes.php  /app/routes/restricoes.php
COPY backend/api/routes/feriados.php    /app/routes/feriados.php

RUN chown -R application:application /app

EXPOSE 80
