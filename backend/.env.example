# ================================================================
# Copie para .env e preencha os valores reais
# No Railway: configure como variáveis de ambiente no painel
# ================================================================

# URL completa de conexão (Railway injeta automaticamente)
DATABASE_URL=mysql://user:pass@host:3306/railway

# Ou variáveis separadas (alternativa ao DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=railway
# DB_USER=root
# DB_PASSWORD=

# Segredo para assinar tokens de sessão
APP_SECRET=troque_por_string_aleatoria_longa_minimo_32_chars

# Ambiente: development ou production
APP_ENV=production

# CORS: URL do frontend React no Railway
CORS_ORIGIN=https://seu-frontend.up.railway.app

# Token opcional para endpoint /api/setup (primeiro deploy)
SETUP_TOKEN=
